# Shared JWT Secret (Minimum 256 bits / 32 chars)
JWT_SECRET=your_super_secret_signing_key_change_in_production_32chars

# Auth Service Database Configuration
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3306
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password

# Core Service Database Configuration
CORE_DB_HOST=localhost
CORE_DB_PORT=3307
CORE_DB_NAME=core_db
CORE_DB_USER=core_user
CORE_DB_PASSWORD=core_password
